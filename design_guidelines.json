  "components": {
    "universal_guidelines": [
      "No rounded corners on main containers. Use clip-path: polygon(...) for torn paper edges if possible, or strict 0px radius.",
      "All Cards must have a subtle paper texture overlay.",
      "Use 'ink' color for text, never pure black.",
      "Buttons should look like wax seals or engraved plates.",
      "Scrollbars must be custom styled (thin, gold/earth colors)."
    ],
    "specific_components": {
      "timeline": {
        "type": "Horizontal Scroll",
        "style": "Continuous line with nodes",
        "node_style": "Circle with gold border, filled with map detail"
      },
      "drawer": {
        "position": "right",
        "width": "420px",
        "background": "bg-parchment",
        "border": "border-l-4 border-gold",
        "shadow": "shadow-2xl"
      },
      "map": {
        "library": "SVG (Custom)",
        "style": "Sepia tone, hand-drawn stroke effect"
      },
      "search": {
        "style": "Full width overlay",
        "animation": "Fade in with blur",
        "input_style": "Transparent background, massive serif font"
      }
    }
  },
  "instructions_to_main_agent": [
    "1. UPDATE TAILWIND CONFIG: Add the custom colors and fonts immediately.",
    "2. ADD FONTS: Import the Google Fonts in index.html or CSS.",
    "3. GLOBAL CSS: Add the parchment texture to the body background with blend mode.",
    "4. COMPONENTS: Modify Shadcn components to remove 'rounded-md' and add custom borders.",
    "5. DATA: Create a 'data.js' file to mock the encyclopedia content (do not leave empty).",
    "6. USE IMAGES: Use the provided image URLs for specific sections.",
    "7. NO PLACEHOLDERS: If an image is missing, use the 'pattern_islamic' or 'background_texture' as fallback.",
    "8. ANIMATION: Use framer-motion for all interactions. Page transitions should be slow fades (0.5s).",
    "9. ACCESSIBILITY: Ensure text contrast on the parchment background is sufficient (use 'ink' color)."
  ]
}