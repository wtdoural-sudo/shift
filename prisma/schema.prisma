generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============================================
// MULTI-TENANT : WORKSPACE
// ============================================

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?

  goNoGoThreshold Int @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      WorkspaceMember[]
  dossiers     Dossier[]
  preuves      Preuve[]
  auditEvents  AuditEvent[]
}

// ============================================
// UTILISATEURS ET RÔLES
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces    WorkspaceMember[]
  assignedTasks Tache[]           @relation("AssignedTo")
  auditEvents   AuditEvent[]
  exigences     Exigence[]        @relation("ExigenceOwner")
  checklistItems ChecklistItem[]  @relation("ChecklistOwner")
}

// Role: ADMIN, EDITOR, VIEWER
model WorkspaceMember {
  id          String    @id @default(cuid())
  role        String    @default("VIEWER")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

// ============================================
// DOSSIER (APPEL D'OFFRES)
// ============================================

// Status: BROUILLON, EN_ANALYSE, GO, NO_GO, EN_PRODUCTION, DEPOSE, ARCHIVE
model Dossier {
  id              String    @id @default(cuid())
  reference       String
  titre           String
  client          String
  description     String?
  datePublication DateTime?
  dateLimite      DateTime?
  montantEstime   Float?
  status          String    @default("BROUILLON")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId     String
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dces            DCE[]
  exigences       Exigence[]
  goNoGoDecisions GoNoGoDecision[]
  checklistItems  ChecklistItem[]
  taches          Tache[]
  memoireTechnique MemoireTechnique?
  exports         Export[]
  dossierPreuves  DossierPreuve[]

  @@index([workspaceId])
}

// ============================================
// DCE
// ============================================

model DCE {
  id            String   @id @default(cuid())
  filename      String
  originalName  String
  mimeType      String
  size          Int
  storagePath   String
  extractedText String?

  createdAt DateTime @default(now())

  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
}

// ============================================
// EXIGENCES
// ============================================

// Priority: HAUTE, MOYENNE, BASSE
// Status: A_TRAITER, EN_COURS, TRAITE, NON_APPLICABLE
model Exigence {
  id          String @id @default(cuid())
  ordre       Int    @default(0)
  titre       String
  description String?
  priority    String @default("MOYENNE")
  status      String @default("A_TRAITER")
  source      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  ownerId   String?
  owner     User?   @relation("ExigenceOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([dossierId])
}

// ============================================
// GO / NO-GO
// ============================================

model GoNoGoDecision {
  id String @id @default(cuid())

  critereFitStrategique Int
  critereCapacite       Int
  critereRentabilite    Int
  critereDelai          Int
  critereRisque         Int

  scoreTotal  Int
  decision    Boolean
  motifNoGo   String?
  commentaire String?

  createdAt DateTime @default(now())

  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
}

// ============================================
// CONFORMITÉ
// ============================================

// Status: A_VERIFIER, CONFORME, NON_CONFORME, NON_APPLICABLE
model ChecklistItem {
  id          String @id @default(cuid())
  ordre       Int    @default(0)
  label       String
  description String?
  status      String @default("A_VERIFIER")
  commentaire String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  ownerId   String?
  owner     User?   @relation("ChecklistOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([dossierId])
}

// ============================================
// TÂCHES
// ============================================

// Status: A_FAIRE, EN_COURS, TERMINE, BLOQUE
// Priority: HAUTE, MOYENNE, BASSE
model Tache {
  id          String    @id @default(cuid())
  titre       String
  description String?
  status      String    @default("A_FAIRE")
  priority    String    @default("MOYENNE")
  echeance    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dossierId  String
  dossier    Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?   @relation("AssignedTo", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([dossierId])
}

// ============================================
// PREUVES
// ============================================

// Type: REFERENCE, CV, CERTIFICATION, DOCUMENT, AUTRE
model Preuve {
  id          String @id @default(cuid())
  titre       String
  description String?
  type        String @default("DOCUMENT")
  tags        String @default("")

  filename    String?
  storagePath String?
  mimeType    String?
  contenu     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dossierPreuves DossierPreuve[]

  @@index([workspaceId])
}

model DossierPreuve {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  preuveId  String
  preuve    Preuve  @relation(fields: [preuveId], references: [id], onDelete: Cascade)

  @@unique([dossierId, preuveId])
}

// ============================================
// MÉMOIRE TECHNIQUE
// ============================================

model MemoireTechnique {
  id String @id @default(cuid())

  sectionPresentation  String?
  sectionComprehension String?
  sectionMethodologie  String?
  sectionEquipe        String?
  sectionReferences    String?
  sectionPlanning      String?
  sectionEngagements   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dossierId String  @unique
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
}

// ============================================
// EXPORTS
// ============================================

// Type: MEMOIRE_PDF, CHECKLIST_PDF, SYNTHESE_PDF
model Export {
  id          String @id @default(cuid())
  type        String
  filename    String
  storagePath String
  version     Int    @default(1)

  createdAt DateTime @default(now())

  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
}

// ============================================
// AUDIT LOG
// ============================================

// Action: CREATE, UPDATE, DELETE, EXPORT, LOGIN, GO_DECISION, NOGO_DECISION
model AuditEvent {
  id          String @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  description String
  metadata    String?

  createdAt DateTime @default(now())

  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdAt])
}
